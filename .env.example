# Clave de API de ElevenLabs (https://elevenlabs.io -> Profile -> API Keys).
# Nunca la pongas en el frontend: solo la lee server/index.js.
ELEVENLABS_API_KEY=

# (Opcional) voice_id de ElevenLabs a usar. Si lo dejas vacío se usa una voz
# multilingüe por defecto. Elige la tuya en https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Puerto del proxy de voz en local (opcional, default 8787).
# En Render/Railway/etc. no lo definas: usan su propia variable PORT.
VOICE_SERVER_PORT=8787
